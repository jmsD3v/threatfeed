# Set ONE of these to enable AI enrichment (threat context + recommendations).
# If more than one is set, priority is: ANTHROPIC_API_KEY > GEMINI_API_KEY > OPENAI_API_KEY.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional — increases rate limits and unlocks premium IOC data
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
OTX_API_KEY=

# Output
THREATFEED_DB=~/.threatfeed/iocs.db
